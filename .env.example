# Lynxclaw environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Anthropic (default) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Alternative: Kimi K2 via Moonshot Anthropic-compatible endpoint ─────────
# Uncomment to use Kimi K2 instead of Anthropic.
# ANTHROPIC_AUTH_TOKEN=sk-...                                    # Moonshot key (takes priority over ANTHROPIC_API_KEY)
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic           # China region
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic           # International
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1                     # Avoids tool_search 400 errors on Kimi

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Feishu / Lark ──────────────────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── Optional overrides ─────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# DB_PATH=data/store/messages.db
